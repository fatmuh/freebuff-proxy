# All settings have sensible defaults — only override what you need.

# Server listen address (default: 0.0.0.0:9187)
# LISTEN_ADDR=0.0.0.0:9187

# Upstream Codebuff API base URL (default: https://www.codebuff.com)
# UPSTREAM_BASE_URL=https://www.codebuff.com

# How often to rotate upstream runs (default: 6h)
# ROTATION_INTERVAL=6h

# Request timeout to upstream (default: 15m)
# REQUEST_TIMEOUT=15m

# HTTP proxy for outbound requests (default: empty = no proxy)
# HTTP_PROXY=
